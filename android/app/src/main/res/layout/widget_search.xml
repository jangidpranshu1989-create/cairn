<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center_vertical" android:orientation="horizontal" android:padding="4dp">
    <LinearLayout android:id="@+id/wg_bar" android:layout_width="match_parent" android:layout_height="52dp"
        android:background="@drawable/wg_pill" android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="16dp" android:paddingEnd="6dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/wg_logo" android:contentDescription="@string/app_name" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp"
            android:text="@string/widget_hint" android:textColor="#FFA3A19B" android:textSize="15sp" android:maxLines="1" android:ellipsize="end"
            android:fontFamily="sans-serif" />
        <ImageView android:id="@+id/wg_mic" android:layout_width="40dp" android:layout_height="40dp" android:padding="10dp" android:src="@drawable/wg_mic"
            android:background="@drawable/wg_circle" android:contentDescription="@string/widget_voice" />
        <ImageView android:id="@+id/wg_ask" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="6dp" android:padding="10dp"
            android:src="@drawable/wg_spark" android:background="@drawable/wg_circle" android:contentDescription="@string/widget_ask" />
    </LinearLayout>
</LinearLayout>
