{
  "name": "cairn-browser",
  "version": "2.4.0",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "keywords": [],
  "author": {
    "name": "Cairn",
    "email": "jangidpranshu1989-create@users.noreply.github.com"
  },
  "license": "UNLICENSED",
  "description": "Cairn \u2014 the agentic browser that shops, reads and works for you.",
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "electron-updater": "^6.8.11"
  },
  "productName": "Cairn",
  "homepage": "https://jangidpranshu1989-create.github.io/cairn",
  "build": {
    "appId": "app.cairn.browser",
    "productName": "Cairn",
    "copyright": "\u00a9 2026 Cairn",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "protocols": [
      {
        "name": "Cairn",
        "schemes": [
          "cairn"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "html",
          "htm",
          "pdf"
        ],
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Cairn",
      "artifactName": "Cairn-Setup-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Cairn uses the microphone for voice commands.",
        "NSCameraUsageDescription": "Websites may request camera access."
      },
      "artifactName": "Cairn-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network;WebBrowser",
      "icon": "build/icon.png",
      "maintainer": "jangidpranshu1989-create@users.noreply.github.com",
      "artifactName": "Cairn-linux-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jangidpranshu1989-create",
        "repo": "cairn"
      }
    ],
    "appImage": {
      "artifactName": "Cairn-linux-x64.${ext}"
    },
    "deb": {
      "artifactName": "Cairn-linux-x64.${ext}"
    }
  },
  "desktopName": "cairn.desktop"
}