{
  "name": "saarthi-browser",
  "version": "1.0.0",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "keywords": [],
  "author": {
    "name": "Saarthi",
    "email": "hello@saarthi.app"
  },
  "license": "UNLICENSED",
  "description": "Saarthi \u2014 the agentic browser that shops, reads and works for you.",
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "electron-updater": "^6.8.11"
  },
  "productName": "Saarthi",
  "homepage": "https://saarthi.app",
  "build": {
    "appId": "app.saarthi.browser",
    "productName": "Saarthi",
    "copyright": "\u00a9 2026 Saarthi",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "protocols": [
      {
        "name": "Saarthi",
        "schemes": [
          "saarthi"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": [
          "html",
          "htm",
          "pdf"
        ],
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Saarthi"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Saarthi uses the microphone for voice commands.",
        "NSCameraUsageDescription": "Websites may request camera access."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network;WebBrowser",
      "icon": "build/icon.png",
      "maintainer": "hello@saarthi.app"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "saarthi-app",
        "repo": "saarthi"
      }
    ]
  }
}