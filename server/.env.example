# --- Core ---
NODE_ENV=production
PORT=8787
PUBLIC_URL=https://api.cairn.app
DATA_DIR=./data
# openssl rand -hex 32  (REQUIRED in production)
JWT_SECRET=

# --- Passkeys (WebAuthn) ---
RP_ID=cairn.app
RP_NAME=Cairn
RP_ORIGINS=https://api.cairn.app,https://cairn.app
CORS_ORIGINS=*

# --- AI (optional server-side keys; desktop users can also bring their own) ---
GROQ_API_KEY=
NVIDIA_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_FAST_MODEL=nvidia/nemotron-3.5-bolt-e4b
STT_MODEL=whisper-large-v3-turbo
DAILY_AI_FREE=300

# --- Email (password reset). Example: smtps://user:pass@smtp.example.com:465 ---
SMTP_URL=
MAIL_FROM=Cairn <no-reply@cairn.app>

# --- Limits ---
MAX_TRANSFER_MB=100
TRANSFER_TTL_HOURS=24
APPROVAL_TTL_SEC=180
