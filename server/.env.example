# --- Core ---
NODE_ENV=production
PORT=8787
# Your server's public https URL, e.g. https://cairn-api.onrender.com or https://cairn-<you>.koyeb.app
PUBLIC_URL=
DATA_DIR=./data
# openssl rand -hex 32  (REQUIRED in production)
JWT_SECRET=

# --- Passkeys (WebAuthn) ---
# Passkeys: the host of PUBLIC_URL (no https://)
RP_ID=
RP_NAME=Cairn
RP_ORIGINS=
CORS_ORIGINS=*

# --- AI ---
# Free key from https://console.groq.com/keys — needed for photo/camera understanding (vision) and fastest answers.
GROQ_API_KEY=
# Free key from https://aistudio.google.com/apikey — second vision fallback (Gemini 2.5 Flash).
GEMINI_API_KEY=
# Optional: OpenRouter key (uses the free router model "openrouter/free")
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_FAST_MODEL=nvidia/nemotron-3.5-bolt-e4b
STT_MODEL=whisper-large-v3-turbo
DAILY_AI_FREE=300

# --- Email (password reset). Example: smtps://user:pass@smtp.example.com:465 ---
SMTP_URL=
MAIL_FROM=Cairn <no-reply@example.com>

# --- Limits ---
MAX_TRANSFER_MB=100
TRANSFER_TTL_HOURS=24
APPROVAL_TTL_SEC=180

# --- Database ---
# Leave empty to use a local SQLite file in DATA_DIR (needs a persistent disk).
# On free hosts (Render/Koyeb wipe the disk on restart) use Turso's free tier: https://turso.tech
#   turso db create cairn && turso db show cairn --url && turso db tokens create cairn
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Permanent storage on Supabase (free): https://supabase.com → Project Settings → API Keys
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=cairn
# SNAPSHOT_SECONDS=15
# SUPABASE_REQUIRED=1
